---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const path = Astro.url.pathname;
const locale: "pt" | "en" = path.startsWith("/en/") || path === "/en" ? "en" : "pt";

const routePairs: Record<string, string> = {
  "/": "/en/",
  "/sobre/": "/en/about/",
  "/pesquisa/": "/en/research/",
  "/publicacoes/": "/en/publications/",
  "/ensino/": "/en/teaching/",
  "/extensao/": "/en/extension/",
  "/software/": "/en/software/",
  "/recursos/": "/en/resources/",
  "/contato/": "/en/contact/",
};

const reverseRoutePairs = Object.fromEntries(
  Object.entries(routePairs).map(([pt, en]) => [en, pt]),
) as Record<string, string>;

const alternatePath = locale === "pt" ? routePairs[path] : reverseRoutePairs[path];

const {
  title,
  description = locale === "en"
    ? "Research, teaching, extension and software in Computing and Artificial Intelligence."
    : "Pesquisa, ensino, extensão e software em Computação e Inteligência Artificial.",
  image = "/social-card.svg",
  noindex = false,
} = Astro.props;

const pageTitle = title === "Tiago Alves de Oliveira"
  ? title
  : `${title} | Tiago Alves de Oliveira`;

const canonicalURL = new URL(path, Astro.site ?? Astro.url.origin);
const imageURL = new URL(image, Astro.site ?? Astro.url.origin);
const alternateURL = alternatePath
  ? new URL(alternatePath, Astro.site ?? Astro.url.origin)
  : undefined;

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const adsenseClient = import.meta.env.PUBLIC_GOOGLE_ADSENSE_CLIENT?.trim();
const adsenseEnabled = import.meta.env.PUBLIC_ENABLE_ADSENSE === "true" && Boolean(adsenseClient);

const structuredData = {
  "@context": "https://schema.org",
  "@type": path === "/" || path === "/en/" ? "ProfilePage" : "WebPage",
  name: pageTitle,
  description,
  url: canonicalURL.toString(),
  inLanguage: locale === "en" ? "en" : "pt-BR",
  isPartOf: {
    "@type": "WebSite",
    name: "Tiago Alves de Oliveira",
    url: new URL("/", Astro.site ?? Astro.url.origin).toString(),
  },
  about: {
    "@type": "Person",
    name: "Tiago Alves de Oliveira",
    jobTitle: locale === "en" ? "Professor and researcher in Computing" : "Professor e pesquisador em Computação",
    affiliation: {
      "@type": "CollegeOrUniversity",
      name: "CEFET-MG",
    },
  },
};
---
<!doctype html>
<html lang={locale === "en" ? "en" : "pt-BR"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Tiago Alves de Oliveira" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f8fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#071a2d" />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {adsenseClient && <meta name="google-adsense-account" content={adsenseClient} />}

    <link rel="canonical" href={canonicalURL} />
    {alternateURL && (
      <>
        <link
          rel="alternate"
          hreflang={locale === "en" ? "pt-BR" : "en"}
          href={alternateURL}
        />
        <link
          rel="alternate"
          hreflang={locale === "en" ? "en" : "pt-BR"}
          href={canonicalURL}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={locale === "en" ? alternateURL : canonicalURL}
        />
      </>
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tiago Alves de Oliveira" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={locale === "en" ? "Tiago Alves de Oliveira academic portal" : "Portal acadêmico de Tiago Alves de Oliveira"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "pt_BR"} />
    {alternateURL && (
      <meta property="og:locale:alternate" content={locale === "en" ? "pt_BR" : "en_US"} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={locale === "en" ? "Tiago Alves de Oliveira academic portal" : "Portal acadêmico de Tiago Alves de Oliveira"} />

    {adsenseEnabled && (
      <script
        async
        crossorigin="anonymous"
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
      ></script>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    <script is:inline>
      const storedTheme = localStorage.getItem("theme");
      const preferredTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = storedTheme ?? preferredTheme;
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {locale === "en" ? "Skip to main content" : "Pular para o conteúdo principal"}
    </a>
    <Header locale={locale} alternatePath={alternatePath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <script is:inline>
      const toggle = document.querySelector(".theme-toggle");
      const root = document.documentElement;

      const syncToggle = () => {
        if (!toggle) return;
        const isDark = root.dataset.theme === "dark";
        toggle.setAttribute("aria-pressed", String(isDark));
        const label = isDark
          ? (toggle.dataset.lightLabel || "Use light theme")
          : (toggle.dataset.darkLabel || "Use dark theme");
        toggle.setAttribute("title", label);
        toggle.setAttribute("aria-label", label);
      };

      syncToggle();

      toggle?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
        syncToggle();
      });
    </script>
    <Footer locale={locale} />
  </body>
</html>
