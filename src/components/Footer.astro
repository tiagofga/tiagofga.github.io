---
interface Props {
  locale?: "pt" | "en";
}
const { locale = "pt" } = Astro.props;
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <strong>Tiago Alves de Oliveira</strong>
      <p>{locale === "en" ? "Computing · Science · Technology · Society" : "Computação · Ciência · Tecnologia · Sociedade"}</p>
    </div>
    <div class="footer-links" aria-label={locale === "en" ? "Footer links" : "Links do rodapé"}>
      <a href="https://github.com/tiagofga">GitHub</a>
      <a href={locale === "en" ? "/en/contact/" : "/contato/"}>{locale === "en" ? "Contact" : "Contato"}</a>
      <a href={locale === "en" ? "/en/about/" : "/sobre/"}>{locale === "en" ? "About" : "Sobre"}</a>
    </div>
  </div>
</footer>
