---
interface Props {
  locale?: "pt" | "en";
}
const { locale = "pt" } = Astro.props;
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <strong>Tiago Alves de Oliveira</strong>
      <p>{locale === "en" ? "Computing · Science · Technology · Society" : "Computação · Ciência · Tecnologia · Sociedade"}</p>
    </div>
    <div class="footer-links" aria-label={locale === "en" ? "External links" : "Links externos"}>
      <a href="https://github.com/tiagofga">GitHub</a>
      <a href="https://lattes.cnpq.br/">Lattes</a>
      <a href="https://orcid.org/">ORCID</a>
    </div>
  </div>
</footer>
