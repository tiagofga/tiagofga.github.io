---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  darkEyebrow?: boolean;
}

const { eyebrow, title, description, darkEyebrow = false } = Astro.props;
---
<div class="section-heading">
  <div>
    <p class:list={["eyebrow", { "eyebrow-dark": darkEyebrow }]}>{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  {description && <p>{description}</p>}
</div>
