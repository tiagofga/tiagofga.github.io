---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout title="Extension" description="Extension projects, courses and workshops in Computing and technology.">
  <section class="archive-hero"><div class="shell"><div class="breadcrumb"><a href="/en/">Home</a> / Extension</div><p class="eyebrow">Extension</p><h1>Academic knowledge connected to the wider community.</h1><p>Projects, courses, workshops and outreach activities will be added as their records are validated.</p></div></section>
  <section class="section"><div class="shell stage2-grid">
    <article class="card stage2-card"><span class="stage2-symbol">PRJ</span><h3>Projects</h3><p>Institutional outreach projects with their own goals, audiences and results.</p></article>
    <article class="card stage2-card"><span class="stage2-symbol">CRS</span><h3>Courses</h3><p>Short courses and educational activities for internal and external audiences.</p></article>
    <article class="card stage2-card"><span class="stage2-symbol">WRK</span><h3>Workshops</h3><p>Hands-on activities, demonstrations and technology training.</p></article>
  </div></section>
</BaseLayout>
