---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout title="Publications" description="Scientific publications, conference papers, datasets and research artifacts.">
  <section class="archive-hero">
    <div class="shell">
      <div class="breadcrumb"><a href="/en/">Home</a> / Publications</div>
      <p class="eyebrow">Publications</p>
      <h1>Scientific output and research artifacts.</h1>
      <p>Publication records will be added after metadata validation.</p>
    </div>
  </section>
  <section class="section">
    <div class="shell publication-grid">
      <article class="card publication-type"><span class="tag">Journals</span><h2>Journal articles</h2><p>Peer-reviewed journal publications.</p></article>
      <article class="card publication-type"><span class="tag">Events</span><h2>Conferences</h2><p>Conference and congress papers.</p></article>
      <article class="card publication-type"><span class="tag">Artifacts</span><h2>Datasets and artifacts</h2><p>Datasets, software and associated research outputs.</p></article>
    </div>
  </section>
</BaseLayout>
