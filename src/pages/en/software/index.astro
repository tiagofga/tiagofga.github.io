---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";

const projects = [
  ["EC-IA","Teaching + Software","Open educational resource for the Artificial Intelligence course.","https://tiagofga.github.io/EC-IA/"],
  ["Algorithms in C","Teaching + Software","Implementations, tests, exercises and documentation for data structures and algorithms.","https://github.com/tiagofga/Estruturas-de-Dados-e-Algoritmos-em-C"],
  ["Modular MLP","Research + Software","Modular multilayer perceptron implementation in modern C++.","https://tiagofga.github.io/mlp/"],
  ["Drug-CNN","Research + Software","Deep learning applied to pharmacological class prediction and drug discovery.","https://github.com/tiagofga/drug-cnn"],
];
---
<BaseLayout
  title="Software"
  description="Open software projects connecting research, teaching and Computing."
>
  <PageHero
    eyebrow="Software"
    title="Open projects for research, teaching and experimentation."
    current="Software"
    homeLabel="Home"
    homeHref="/en/"
    description="This area highlights selected projects. Detailed technical documentation remains in each repository or project website, while this portal provides context and discovery."
  />

  <section class="section">
    <div class="shell">
      <div class="software-directory">
        {projects.map(([title,type,description,href]) => (
          <article class="card software-entry">
            <div class="software-mark">{title}</div>
            <div class="software-entry-body">
              <span class="tag">{type}</span>
              <h2>{title}</h2>
              <p>{description}</p>
              <a class="card-link" href={href}>Open project ↗</a>
            </div>
          </article>
        ))}
      </div>

      <div class="notice stage2-notice">
        <strong>Curated selection:</strong> this page is not an automatic mirror of GitHub. Only representative research, teaching and technical projects are included.
      </div>
    </div>
  </section>
</BaseLayout>
