---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout title="Resources" description="Articles, tutorials, technical notes, short courses and reusable educational resources.">
  <section class="archive-hero"><div class="shell"><div class="breadcrumb"><a href="/en/">Home</a> / Resources</div><p class="eyebrow">Resources</p><h1>Technical and educational content for consultation and reuse.</h1><p>Legacy content will only be republished after technical and editorial review.</p></div></section>
  <section class="section"><div class="shell resource-grid">
    <article class="card resource-card"><span class="stage2-symbol">ART</span><h2>Articles</h2><p>Technical writing and contextualized editorial content.</p></article>
    <article class="card resource-card"><span class="stage2-symbol">TUT</span><h2>Tutorials</h2><p>Reviewed technical guides and practical instructions.</p></article>
    <article class="card resource-card"><span class="stage2-symbol">TN</span><h2>Technical notes</h2><p>Short references and supporting documentation.</p></article>
    <article class="card resource-card"><span class="stage2-symbol">MINI</span><h2>Short courses</h2><p>Standalone educational material beyond regular courses.</p></article>
  </div></section>
</BaseLayout>
