---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout title="Teaching" description="Current courses, educational resources and historical teaching archive.">
  <section class="teaching-hero">
    <div class="shell teaching-hero-grid">
      <div>
        <div class="breadcrumb"><a href="/en/">Home</a> / Teaching</div>
        <p class="eyebrow eyebrow-dark">Teaching</p>
        <h1>Current courses and educational resources.</h1>
        <p class="lead-dark">Current teaching is presented separately from the historical archive.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell current-courses">
      <article class="card current-course"><div class="course-topline"><span class="course-code">AI</span><span class="tag">2026/2</span></div><h3>Artificial Intelligence</h3><p>Current materials, activities and supplementary resources.</p><a class="button light" href="https://tiagofga.github.io/EC-IA/">Open course ↗</a></article>
      <article class="card current-course"><div class="course-topline"><span class="course-code">LIPC</span><span class="tag">2026/2</span></div><h3>Introduction to Computer Programming Laboratory</h3><p>Programming laboratory activities and semester materials.</p><span class="course-status">Portal integration in progress</span></article>
    </div>
    <div class="notice stage2-notice"><strong>Historical archive:</strong> legacy course pages remain available in Portuguese while the archive is reviewed and translated selectively. <a class="card-link" href="/ensino/#acervo">Open Portuguese archive →</a></div>
  </section>
</BaseLayout>
