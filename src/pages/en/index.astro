---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
---
<BaseLayout
  title="Tiago Alves de Oliveira"
  description="Academic portal for research, teaching, extension and open software in Computing and Artificial Intelligence."
>
  <section class="hero">
    <div class="shell hero-inner">
      <div>
        <p class="eyebrow">Knowledge · Code · Impact</p>
        <h1>Computing, Artificial Intelligence and Science applied to research and education.</h1>
        <p class="lead">Research, teaching, extension, open software and the academic teaching archive gathered in a single portal.</p>
        <div class="hero-actions">
          <a class="button primary" href="/en/research/">Explore research →</a>
          <a class="button secondary" href="/en/about/">About me</a>
        </div>
      </div>
      <aside class="hero-profile-card" aria-label="Profile summary">
        <div class="profile-monogram" aria-hidden="true">TAO</div>
        <div>
          <p class="hero-profile-name">Tiago Alves de Oliveira</p>
          <p class="hero-profile-role">Professor · CEFET-MG</p>
          <p class="hero-profile-text">Research and teaching in Artificial Intelligence, machine learning, drug discovery and scientific software.</p>
          <a class="hero-profile-link" href="/en/about/">View profile →</a>
        </div>
      </aside>
    </div>
  </section>

  <div class="shell pillars">
    <article class="card pillar">
      <div class="icon">AI</div>
      <h3>Research</h3>
      <p>From scientific questions to computational models.</p>
      <ul><li>Applied AI</li><li>Drug discovery</li><li>ADMET and bioinformatics</li><li>Computer vision</li></ul>
      <a class="card-link" href="/en/research/">View research →</a>
    </article>
    <article class="card pillar">
      <div class="icon">EDU</div>
      <h3>Teaching</h3>
      <p>Current courses, educational resources and the historical teaching archive.</p>
      <ul><li>Artificial Intelligence · 2026/2</li><li>Programming Lab · 2026/2</li><li>Educational resources</li><li>Historical archive</li></ul>
      <a class="card-link" href="/en/teaching/">View teaching →</a>
    </article>
    <article class="card pillar">
      <div class="icon">&lt;/&gt;</div>
      <h3>Software</h3>
      <p>Open projects connecting research and education.</p>
      <ul><li>EC-IA</li><li>MLP</li><li>Drug-CNN</li><li>Algorithms in C</li></ul>
      <a class="card-link" href="/en/software/">View software →</a>
    </article>
  </div>

  <section class="section home-profile-section">
    <div class="shell home-profile-grid">
      <div>
        <p class="eyebrow eyebrow-dark">Profile</p>
        <h2>Teaching, research and software development in Computing.</h2>
        <p>Professor at CEFET-MG working in Artificial Intelligence, machine learning and computational applications in science and health.</p>
      </div>
      <div class="home-profile-actions">
        <a class="button light" href="/en/about/">View profile →</a>
        <a class="card-link" href="/en/contact/">Academic contact →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Selected projects"
        title="Open software and educational resources"
        description="Independent projects remain in their own repositories and websites, while the portal provides academic context and discovery."
      />
      <div class="projects">
        <article class="card project-card"><div class="project-visual">EC-IA</div><div class="project-body"><span class="tag">Teaching + Software</span><h3>EC-IA</h3><p>Open educational resource for Artificial Intelligence.</p><a class="card-link" href="https://tiagofga.github.io/EC-IA/">Explore →</a></div></article>
        <article class="card project-card"><div class="project-visual">{ C }</div><div class="project-body"><span class="tag">Teaching + Software</span><h3>Data Structures and Algorithms in C</h3><p>Implementations, tests, exercises and documentation.</p><a class="card-link" href="https://github.com/tiagofga/Estruturas-de-Dados-e-Algoritmos-em-C">GitHub →</a></div></article>
        <article class="card project-card"><div class="project-visual">MLP</div><div class="project-body"><span class="tag">Research + Software</span><h3>Modular MLP</h3><p>A neural network implementation from scratch in modern C++.</p><a class="card-link" href="https://tiagofga.github.io/mlp/">Explore →</a></div></article>
        <article class="card project-card"><div class="project-visual">Drug-CNN</div><div class="project-body"><span class="tag">Research + Software</span><h3>Drug-CNN</h3><p>Deep learning applied to pharmacological class prediction and drug discovery.</p><a class="card-link" href="https://github.com/tiagofga/drug-cnn">GitHub →</a></div></article>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="shell">
      <SectionHeading
        eyebrow="Current teaching"
        title="Courses in progress · 2026/2"
        description="The current semester appears first. Historical material remains available separately."
      />
      <div class="current-home-courses">
        <article class="card content-panel">
          <span class="tag">CEFET-MG · 2026/2</span>
          <h2>Artificial Intelligence</h2>
          <p>Current materials, activities and supplementary resources.</p>
          <a class="button light" href="https://tiagofga.github.io/EC-IA/">Open course ↗</a>
        </article>
        <article class="card content-panel">
          <span class="tag">CEFET-MG · 2026/2</span>
          <h2>Introduction to Computer Programming Laboratory</h2>
          <p>Programming laboratory activities, exercise lists and semester materials.</p>
          <a class="button light" href="/en/teaching/">View teaching →</a>
        </article>
      </div>

      <div class="archive-home-callout card">
        <div>
          <span class="tag">Historical archive</span>
          <h3>Materials from previous years</h3>
          <p>Legacy courses are organized by institution and year and remain separate from current teaching.</p>
        </div>
        <a class="card-link" href="/ensino/#acervo">Open Portuguese archive →</a>
      </div>
    </div>
  </section>

  <section class="section stage2-home-section">
    <div class="shell">
      <SectionHeading
        eyebrow="Other areas"
        title="Outreach and resources"
        description="Dedicated areas for university outreach and reusable technical content."
        darkEyebrow={true}
      />
      <div class="stage2-home-grid">
        <article class="card stage2-home-card">
          <span class="stage2-symbol">EXT</span>
          <h3>Outreach</h3>
          <p>Projects, short courses, workshops and activities connecting Computing with the wider community.</p>
          <a class="card-link" href="/en/extension/">View outreach →</a>
        </article>
        <article class="card stage2-home-card">
          <span class="stage2-symbol">RES</span>
          <h3>Resources</h3>
          <p>Articles, tutorials, technical notes, short courses and reviewed educational materials.</p>
          <a class="card-link" href="/en/resources/">Explore resources →</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
