---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout title="Research" description="Research in applied Artificial Intelligence, machine learning, drug discovery, bioinformatics and computer vision.">
  <section class="archive-hero">
    <div class="shell">
      <div class="breadcrumb"><a href="/en/">Home</a> / Research</div>
      <p class="eyebrow">Research</p>
      <h1>Applied Artificial Intelligence for scientific and computational problems.</h1>
      <p>Research interests connecting machine learning, scientific software, drug discovery, bioinformatics and computer vision.</p>
    </div>
  </section>
  <section class="section">
    <div class="shell research-grid">
      <article class="card research-card"><span class="tag">AI</span><h3>Machine Learning</h3><p>Model development, evaluation and reproducible computational pipelines.</p></article>
      <article class="card research-card"><span class="tag">Drug discovery</span><h3>Drug discovery</h3><p>Computational methods for molecular classification and virtual screening.</p></article>
      <article class="card research-card"><span class="tag">ADMET</span><h3>Bioinformatics and ADMET</h3><p>Predictive modelling and computational analysis related to pharmacological properties.</p></article>
      <article class="card research-card"><span class="tag">Vision</span><h3>Computer Vision</h3><p>Image-based models and visual representations for scientific applications.</p></article>
    </div>
  </section>
</BaseLayout>
