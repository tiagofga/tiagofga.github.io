---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
---
<BaseLayout
  title="Contact"
  description="Professional and academic contact channels for Tiago Alves de Oliveira."
>
  <PageHero
    eyebrow="Contact"
    title="Academic and professional contact."
    current="Contact"
    homeLabel="Home"
    homeHref="/en/"
    description="For research, teaching, collaboration or software-related matters, use the professional channels associated with this portal and its projects."
  />

  <section class="section">
    <div class="shell contact-grid">
      <article class="card contact-card">
        <span class="contact-symbol">CEFET</span>
        <h2>Institutional</h2>
        <p>CEFET-MG · Divinópolis Campus<br />Computer Engineering</p>
        <p class="contact-note">Specific institutional contact details will be added after the official links have been validated.</p>
      </article>

      <article class="card contact-card">
        <span class="contact-symbol">&lt;/&gt;</span>
        <h2>GitHub</h2>
        <p>Research, teaching and open-source software repositories.</p>
        <a class="button light" href="https://github.com/tiagofga">github.com/tiagofga ↗</a>
      </article>

      <article class="card contact-card">
        <span class="contact-symbol">WEB</span>
        <h2>Portal</h2>
        <p>Use the thematic areas of the site to find projects, materials and publications before getting in touch.</p>
        <a class="button light" href="/en/">Back to home →</a>
      </article>
    </div>
  </section>
</BaseLayout>
