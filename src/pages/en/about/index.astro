---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout title="About" description="Academic background, professional profile and areas of interest of Tiago Alves de Oliveira.">
  <section class="archive-hero profile-hero">
    <div class="shell">
      <div class="breadcrumb"><a href="/en/">Home</a> / About</div>
      <p class="eyebrow">Academic profile</p>
      <h1>Tiago Alves de Oliveira</h1>
      <p>Professor in Computing, researcher in Artificial Intelligence and coordinator of the Computer Engineering program at CEFET-MG, Divinópolis Campus.</p>
    </div>
  </section>
  <section class="section">
    <div class="shell profile-layout">
      <div class="profile-main">
        <article class="card content-panel">
          <h2>Professional activity</h2>
          <p>My work combines teaching, research, software development and academic supervision in Computing, with emphasis on applied Artificial Intelligence.</p>
          <p>At CEFET-MG, I work as a professor and in the coordination of the Computer Engineering program at the Divinópolis Campus.</p>
        </article>
        <article class="card content-panel">
          <h2>Education</h2>
          <div class="timeline-list">
            <div class="timeline-item"><span class="timeline-marker"></span><div><strong>PhD in Bioengineering</strong><p>Federal University of São João del-Rei (UFSJ), including a research period at the University of Ottawa.</p></div></div>
            <div class="timeline-item"><span class="timeline-marker"></span><div><strong>MSc in Computer Science</strong><p>Federal University of Espírito Santo (UFES).</p></div></div>
            <div class="timeline-item"><span class="timeline-marker"></span><div><strong>BSc in Computer Science</strong><p>Centro Universitário de Formiga (UNIFOR-MG).</p></div></div>
          </div>
        </article>
      </div>
      <aside class="profile-sidebar">
        <article class="card side-card">
          <h3>Areas of interest</h3>
          <ul><li>Artificial Intelligence</li><li>Machine Learning</li><li>Drug discovery</li><li>Bioinformatics</li><li>Computer Vision</li><li>Algorithms and scientific software</li></ul>
        </article>
      </aside>
    </div>
  </section>
</BaseLayout>
