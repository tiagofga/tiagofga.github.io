---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---
<BaseLayout
  title="Sobre"
  description="Trajetória acadêmica, formação e atuação de Tiago Alves de Oliveira."
>
  <PageHero
    eyebrow="Perfil acadêmico"
    title="Tiago Alves de Oliveira"
    current="Sobre"
    description="Professor de Computação, pesquisador em Inteligência Artificial e coordenador do curso de Engenharia de Computação do CEFET-MG, Campus Divinópolis."
  />

  <section class="section">
    <div class="shell profile-layout">
      <div class="profile-main">
        <article class="card content-panel">
          <h2>Atuação</h2>
          <p>
            Minha atuação reúne ensino, pesquisa, desenvolvimento de software e orientação
            acadêmica em Computação, com ênfase em Inteligência Artificial aplicada.
          </p>
          <p>
            No CEFET-MG, atuo como Professor EBTT e na coordenação do curso de Engenharia
            de Computação do Campus Divinópolis. O portal organiza materiais de ensino,
            projetos, produção científica, software e o acervo da trajetória docente.
          </p>
        </article>

        <article class="card content-panel">
          <h2>Formação</h2>
          <div class="timeline-list">
            <div class="timeline-item">
              <span class="timeline-marker"></span>
              <div>
                <strong>Doutorado em Bioengenharia</strong>
                <p>Universidade Federal de São João del-Rei (UFSJ), com período de pesquisa na University of Ottawa.</p>
              </div>
            </div>
            <div class="timeline-item">
              <span class="timeline-marker"></span>
              <div>
                <strong>Mestrado em Informática</strong>
                <p>Universidade Federal do Espírito Santo (UFES).</p>
              </div>
            </div>
            <div class="timeline-item">
              <span class="timeline-marker"></span>
              <div>
                <strong>Bacharelado em Ciência da Computação</strong>
                <p>Centro Universitário de Formiga (UNIFOR-MG).</p>
              </div>
            </div>
          </div>
        </article>
      </div>

      <aside class="profile-sidebar">
        <article class="card side-card">
          <h3>Áreas de interesse</h3>
          <ul>
            <li>Inteligência Artificial</li>
            <li>Aprendizado de Máquina</li>
            <li>Descoberta de fármacos</li>
            <li>Bioinformática</li>
            <li>Visão Computacional</li>
            <li>Algoritmos e software científico</li>
          </ul>
        </article>

        <article class="card side-card">
          <h3>Navegação</h3>
          <div class="stack-links">
            <a class="card-link" href="/pesquisa/">Pesquisa →</a>
            <a class="card-link" href="/publicacoes/">Publicações →</a>
            <a class="card-link" href="/ensino/">Ensino →</a>
            <a class="card-link" href="/contato/">Contato →</a>
          </div>
        </article>
      </aside>
    </div>
  </section>
</BaseLayout>
