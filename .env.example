# Optional Search Console verification token
PUBLIC_GOOGLE_SITE_VERIFICATION=

# AdSense account/client identifier, e.g. ca-pub-1234567890123456
PUBLIC_GOOGLE_ADSENSE_CLIENT=

# ads.txt publisher identifier, e.g. pub-1234567890123456
PUBLIC_GOOGLE_ADSENSE_PUBLISHER_ID=

# Keep false until the AdSense account, privacy messaging/CMP and site review are ready.
PUBLIC_ENABLE_ADSENSE=false
